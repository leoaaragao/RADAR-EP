# RADAR-EP — Variáveis de Ambiente (TEMPLATE PÚBLICO)
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA versione o arquivo .env!

# ── API Portal da Transparência (CGU) ──────────────────────────
# Cadastro gratuito em: https://portaldatransparencia.gov.br/api-de-dados/cadastrar-email
PORTAL_TRANSPARENCIA_KEY=sua_chave_aqui

# ── Anthropic (Claude) ──────────────────────────────────────────
# Obtenha em: https://console.anthropic.com/
ANTHROPIC_API_KEY=sua_chave_aqui

# ── Google Cloud Platform (Base dos Dados / BigQuery) ──────────
# Projeto com billing ativo para consultas BigQuery
GCP_PROJECT_ID=nice-stack-440319-c6

# ── Caminhos de dados ──────────────────────────────────────────
# Pasta onde os CSVs estão armazenados (relativo à raiz do projeto)
DATA_DIR=data

# ── Configuração do banco DuckDB ───────────────────────────────
DUCKDB_PATH=radar_ep.duckdb

# ── Configuração da API FastAPI ────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Autenticação MPF (para endpoints restritos) ────────────────
# Chave secreta para geração de tokens JWT
MPF_SECRET_KEY=gere_um_valor_aleatorio_seguro_aqui
